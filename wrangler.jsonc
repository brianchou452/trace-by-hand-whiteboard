{
  // Static site on Cloudflare Workers (Static Assets). Deploy: npx wrangler deploy
  "name": "coding-practice",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public"
  },
  "routes": [
    {
      "pattern": "coding-practice.seaotter.cc",
      "custom_domain": true
    }
  ]
}